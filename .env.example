# # --- MongoDB ---
# # Local (Docker Compose): mongodb://mongo:27017/ai-website-optimizer
# MONGODB_URI=mongodb://localhost:27017/ai-website-optimizer

# # --- Redis (BullMQ + rate limiting) ---
# # Local (Docker Compose): redis://redis:6379
# REDIS_URL=redis://localhost:6379

# # --- NextAuth ---
# NEXTAUTH_SECRET=replace-with-a-long-random-string   # generate: openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:3000

# # --- Gemini (server-side only, never exposed to the client) ---
# # Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=...

# # --- Admin seeding ---
# # Read only by `npm run seed:admin`. Sign up with this email first, then
# # run the script to promote that account to role "admin".
# ADMIN_SEED_EMAIL=you@example.com

# # --- Worker ---
# WORKER_CONCURRENCY=2
